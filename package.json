    "verify:manifests": "node scripts/verify-manifests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "happy-dom": "^20.12.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  }
}
