{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "outDir": ".output/local-service",
    "rootDir": "src/local-service",
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["src/local-service/**/*.ts"]
}
